<Window x:Class="LSCKinectFramework.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LSC · Deletreo"
        Width="1180"
        Height="760"
        MinWidth="940"
        MinHeight="640"
        FontFamily="Segoe UI"
        Background="#F1F5F9"
        Foreground="#14243B"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#E7EDF5"/>
            <Setter Property="Foreground" Value="#14243B"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo"
                                CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo"
                                        Property="Opacity"
                                        Value="0.85"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fondo"
                                        Property="Opacity"
                                        Value="0.65"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Fondo"
                                        Property="BorderBrush"
                                        Value="#2563EB"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fondo"
                                        Property="Opacity"
                                        Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Grid Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="De tus manos al texto"
                           FontSize="30"
                           FontWeight="Bold"/>

                <TextBlock Text="Deletreo en Lengua de Señas Colombiana"
                           Foreground="#52647A"
                           FontSize="15"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="#DBEAFE"
                    CornerRadius="14"
                    Padding="16,8">

                <TextBlock x:Name="ModoDeletreo"
                           Text="EN PAUSA"
                           Foreground="#1E40AF"
                           FontWeight="Bold"/>
            </Border>
        </Grid>

        <!-- Cámara y texto -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="#14243B"
                    CornerRadius="20"
                    Padding="20">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="TU CÁMARA"
                               Foreground="#B9CADF"
                               FontWeight="SemiBold"
                               Margin="0,0,0,14"/>

                    <Grid Grid.Row="1"
                          Background="#0B1423">

                        <TextBlock Text="Esperando imagen del Kinect"
                                   Foreground="#A8BDD6"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <Image x:Name="ImagenKinect"
                               Stretch="Uniform"/>
                    </Grid>

                    <TextBlock x:Name="EstadoKinect"
                               Grid.Row="2"
                               Text="Conectando con el Kinect…"
                               Foreground="#D1E0F2"
                               TextWrapping="Wrap"
                               Margin="0,16,0,0"/>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="20"
                    Padding="24">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,16">
                        <TextBlock x:Name="ContadorTexto"
                                   DockPanel.Dock="Right"
                                   Text="0 caracteres"
                                   Foreground="#52647A"/>

                        <TextBlock Text="TU TEXTO"
                                   FontWeight="Bold"/>
                    </DockPanel>

                    <Border Grid.Row="1"
                            Background="#F6F8FC"
                            CornerRadius="14"
                            Padding="16">

                        <TextBox x:Name="TextoDeletreo"
                                 IsReadOnly="True"
                                 Text=""
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="32"
                                 Foreground="#14243B"
                                 AutomationProperties.Name="Texto reconocido"/>
                    </Border>

                    <TextBlock x:Name="EstadoDeletreo"
                               Grid.Row="2"
                               Text="Pulsa Iniciar deletreo para comenzar."
                               TextWrapping="Wrap"
                               Foreground="#52647A"
                               Margin="0,16,0,16"/>

                    <WrapPanel x:Name="EdicionTexto"
                               Grid.Row="3">

                        <Button Content="Espacio"
                                Tag="space"
                                Click="EditarTexto_Click"/>

                        <Button Content="Borrar"
                                Tag="backspace"
                                Click="EditarTexto_Click"/>

                        <Button Content="Limpiar"
                                Tag="clear"
                                Background="#FFF1F2"
                                Foreground="#9F1239"
                                Click="EditarTexto_Click"/>
                    </WrapPanel>

                    <WrapPanel Grid.Row="4"
                               Margin="0,6,0,0">

                        <Button Content="Guardar TXT"
                                Click="GuardarTexto_Click"/>

                        <Button Content="Leer texto"
                                Background="#DDF6ED"
                                Foreground="#12634B"
                                Click="LeerTexto_Click"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Control principal -->
        <Grid Grid.Row="2"
              Margin="0,22,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Text="Mantén la letra hasta verla escrita. Retira la mano antes de la siguiente."
                Foreground="#52647A"
                TextWrapping="Wrap"
                VerticalAlignment="Center"
                Margin="0,0,24,0"/>

            <Button x:Name="BotonDeletreo"
                    Grid.Column="1"
                    Content="Iniciar deletreo"
                    Background="#12634B"
                    Foreground="White"
                    MinWidth="190"
                    Margin="0"
                    Click="Deletreo_Click" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
